{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redfish-ctl/schemas/gates.schema.json",
  "title": "Gate registry",
  "description": "Canonical registry of every mandatory gate (gates/manifest.yaml).",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec",
    "version",
    "runner_tag",
    "required_jobs",
    "mandatory_ids",
    "gates"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "homelab.embedings.ai/v1alpha1"
    },
    "kind": {
      "const": "GateRegistry"
    },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["gates"],
      "additionalProperties": false,
      "properties": {
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/providerGate"
          }
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "runner_tag": {
      "type": "string",
      "minLength": 1
    },
    "required_jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "diagnostic_jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "trusted_includes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project", "ref", "file"],
        "anyOf": [
          {"required": ["templates"]},
          {"required": ["jobs"]}
        ],
        "properties": {
          "project": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "ref": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "file": {
            "type": "string",
            "pattern": "^/[^\\n]+\\.ya?ml$"
          },
          "templates": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "mutates"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^\\.[A-Za-z0-9_.-]+$"
                },
                "mutates": {
                  "type": "boolean"
                }
              }
            }
          },
          "jobs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "required",
                "mutates",
                "stage",
                "image",
                "tags",
                "allowFailure",
                "script"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                },
                "required": {"const": true},
                "mutates": {"type": "boolean"},
                "stage": {"type": "string", "minLength": 1},
                "image": {
                  "type": "string",
                  "pattern": "^[^\\s]+@sha256:[0-9a-f]{64}$"
                },
                "tags": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                },
                "allowFailure": {"const": false},
                "script": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    },
    "mandatory_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "profile",
          "command",
          "required",
          "mutates"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
          },
          "profile": {
            "type": "string",
            "enum": [
              "merge",
              "integration",
              "scheduled",
              "deploy",
              "repository-export"
            ]
          },
          "command": {
            "type": "string",
            "pattern": "^scripts/gates/.+\\.sh$"
          },
          "required": {
            "type": "boolean"
          },
          "mutates": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "providerGate": {
      "type": "object",
      "required": [
        "id",
        "category",
        "phase",
        "required",
        "status",
        "isolation",
        "permissions",
        "executionSurface",
        "requiredCredentialNames",
        "platform",
        "workload",
        "expectedCost",
        "timeoutSeconds",
        "mutation",
        "offlineFixture",
        "profiles",
        "output",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "category": {
          "enum": [
            "meta",
            "toolbox",
            "scm",
            "repo",
            "mutation",
            "unit",
            "render",
            "policy",
            "integration",
            "apply-protection",
            "verification",
            "rollback",
            "evidence"
          ]
        },
        "phase": {
          "enum": [
            "repository",
            "unit",
            "render",
            "policy",
            "integration",
            "plan",
            "apply",
            "verify",
            "rollback",
            "evidence"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "const": "active"
        },
        "isolation": {
          "enum": ["offline", "network", "cluster"]
        },
        "permissions": {
          "enum": [
            "read-only",
            "namespace-scoped",
            "protected-live-apply"
          ]
        },
        "executionSurface": {
          "enum": [
            "github",
            "internal-gitlab",
            "protected-kubernetes"
          ]
        },
        "requiredCredentialNames": {
          "type": "array",
          "items": {
            "enum": [
              "GITLAB_PROJECT_ID",
              "GITLAB_PROJECT_TOKEN",
              "GITLAB_URL",
              "KUBECONFIG",
              "SPLUNK_API_TOKEN",
              "SPLUNK_O11Y_REALM"
            ]
          },
          "uniqueItems": true
        },
        "platform": {
          "enum": ["portable", "linux/amd64"]
        },
        "workload": {
          "enum": ["cpu", "project-integration", "protected-mutation"]
        },
        "expectedCost": {
          "enum": ["low", "medium", "high"]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "mutation": {
          "type": "boolean"
        },
        "offlineFixture": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "uniqueItems": true
        },
        "output": {
          "type": "string",
          "pattern": "^reports/gates/[a-z0-9.-]+\\.json$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
