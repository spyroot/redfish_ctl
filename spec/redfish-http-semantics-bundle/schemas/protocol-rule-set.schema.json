{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/redfish-semantics/protocol-rule-set.schema.json",
  "title": "Redfish Protocol Rule Set",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "redfish.semantics/v1alpha1"},
    "kind": {
      "enum": [
        "ProtocolManifest",
        "ProtocolRuleSet",
        "StatusCatalog",
        "CoverageLedger",
        "OemCompatibilityOverlay"
      ]
    },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "spec": {"type": "object"}
  },
  "additionalProperties": false
}
