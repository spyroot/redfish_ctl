{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redfish-ctl/schemas/dmtf-sim-values.schema.json",
  "title": "DMTF simulator Helm values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicaCount",
    "image",
    "imagePullSecrets",
    "dmtf",
    "provenance",
    "containerPort",
    "service",
    "serviceAccount",
    "networkPolicy",
    "resources"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
      }
    },
    "dmtf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundleRelease", "bundleSha256", "profile"],
      "properties": {
        "bundleRelease": {
          "type": "string",
          "enum": ["2026.1"]
        },
        "bundleSha256": {
          "type": "string",
          "enum": [
            "481990aa1e77a675b5cc919483b4bc2dd8e832f91ba9b0e3f001ee2b2c8ddef7"
          ]
        },
        "profile": {
          "type": "string",
          "enum": [
            "public-acd",
            "public-applications",
            "public-bladed",
            "public-bladed-partitions",
            "public-cables",
            "public-catfish",
            "public-composability",
            "public-compose-action",
            "public-constrained-composition",
            "public-cooling-unit",
            "public-cxl",
            "public-cxl-multiswitch",
            "public-expansion-box",
            "public-iiot",
            "public-liquid-cooled-server",
            "public-localstorage",
            "public-mpf",
            "public-nvmeof-jbof",
            "public-oem-examples",
            "public-pdu",
            "public-pmem-configuration",
            "public-power-shelf",
            "public-rackmount1",
            "public-sasfabric",
            "public-smartnic",
            "public-telemetry",
            "public-tower"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCommit"],
      "properties": {
        "sourceCommit": {
          "type": "string",
          "pattern": "^$|^[0-9a-f]{40}$"
        }
      }
    },
    "containerPort": {
      "type": "integer",
      "enum": [8080]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP"]
        },
        "port": {
          "type": "integer",
          "enum": [80]
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "allowedNamespaceLabels"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowedNamespaceLabels": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["homelab.embedings.ai/ci-class"],
            "properties": {
              "homelab.embedings.ai/ci-class": {
                "type": "string",
                "enum": ["validation", "protected"]
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": {"type": "string", "minLength": 1},
            "memory": {"type": "string", "minLength": 1}
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": {"type": "string", "minLength": 1},
            "memory": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "serviceAccount": {
            "properties": {"create": {"const": false}},
            "required": ["create"]
          }
        }
      },
      "then": {
        "properties": {
          "serviceAccount": {
            "properties": {"name": {"minLength": 1}}
          }
        }
      }
    }
  ]
}
